 {%- set effective_reasoning_effort = reasoning_effort if reasoning_effort is defined and reasoning_effort in ['low', 'high'] else 'max' -%}
 {%- if effective_reasoning_effort is not none -%}<|system|>Reasoning Effort: {{ effective_reasoning_effort | capitalize }}{%- endif -%}
 {%- set clear_thinking = clear_thinking if clear_thinking is defined else false -%}
+{%- set _oc_has_tools = (tools is defined) and tools -%}
+{%- set _oc_last_user = namespace(text='') -%}
+{%- for _m in messages -%}
+    {%- if _m.role == 'user' -%}
+        {%- if _m.content is string -%}
+            {%- set _oc_last_user.text = _m.content -%}
+        {%- else -%}
+            {%- set _oc_last_user.text = _m.content | tojson -%}
+        {%- endif -%}
+    {%- endif -%}
+{%- endfor -%}
+{%- set _oc_is_code = ('原始碼' in _oc_last_user.text) or ('code' in (_oc_last_user.text | lower)) or ('python' in (_oc_last_user.text | lower)) -%}
+{%- set _oc_rules = '' -%}
+{%- if not _oc_has_tools -%}
+    {%- if 'json' in (_oc_last_user.text | lower) -%}
+        {%- set _oc_rules = 'JSON output contract (applies to this request): 1) Output exactly one JSON value and nothing else: no Markdown code fence, no preamble, no suffix, no headings. 2) Copy requested key names verbatim; never rename, add, or drop a field. 3) When asked to preserve original wording, copy the source fragment verbatim; never paraphrase, pad, or truncate it. 4) Use the requested types: integers as numbers, booleans as true/false, missing values as null; never stringify numbers or booleans. 5) null means cleared/absent; [] means confirmed-empty. Never mix them. 6) started is not completed: continued only means started; an item stays in pending until completion is reported. 7) If unsure, emit the requested fields with null; never invent ids, filenames, or numbers. 8) Follow the specification exactly; do not add extra validation, assumptions, or commentary beyond what is requested.' -%}
+    {%- elif _oc_is_code -%}
+        {%- set _oc_rules = 'Code output contract (applies to this request): Output only the raw source code. No Markdown code fence, no preamble, no explanation, no suffix. The first character must be code. Follow the specification exactly; do not add extra validation, assumptions, or commentary beyond what is requested.' -%}
+    {%- endif -%}
+{%- else -%}
+    {%- set _oc_has_tool_results = false -%}
+    {%- for _m in messages -%}
+        {%- if _m.role == 'tool' -%}{%- set _oc_has_tool_results = true -%}{%- endif -%}
+    {%- endfor -%}
+    {%- if _oc_has_tool_results and ('json' in (_oc_last_user.text | lower)) -%}
+        {%- set _oc_rules = 'After tool results, output only the final JSON value. No Markdown code fence, no preamble, no suffix, no trailing explanation. Follow the specification exactly.' -%}
+    {%- endif -%}
+{%- endif -%}
+{%- if _oc_rules -%}<|system|>{{ _oc_rules }}{%- endif -%}
 {%- if tools -%}
 {%- macro tool_to_json(tool) -%}
     {%- set ns_tool = namespace(first=true) -%}
